# Copy this file to `.env.local` and fill in your values.
#
#   cp .env.local.example .env.local
#
# `.env.local` is gitignored and must NEVER be committed. The e2e harness (examples/e2e) loads it
# automatically; real environment variables, if set, take precedence over what's in this file.

# Required for any real API call. Your Quickpay API key (manager > Settings > API user).
QUICKPAY_API_KEY=

# Required to verify callbacks. Your account private key (manager > Settings > Integration).
# This is DIFFERENT from the API key above.
QUICKPAY_PRIVATE_KEY=

# Optional. The public https URL that reaches your local listener (e.g. from `expose share`). Payum
# builds the callback/continue/cancel token urls on it, so Quickpay must be able to reach it.
QUICKPAY_CALLBACK_BASE=

# Optional gateway options — these map 1:1 onto the gateway configuration.
QUICKPAY_ORDER_PREFIX=e2e-
QUICKPAY_LANGUAGE=en
# Comma-separated, e.g. creditcard,!jcb (see README). Leave empty for the account default.
QUICKPAY_PAYMENT_METHODS=
# 1 to capture automatically once an approved authorize is confirmed by the callback.
QUICKPAY_AUTO_CAPTURE=
# 1 to make capture/refund/cancel wait for the settled transaction instead of relying on the callback.
QUICKPAY_SYNCHRONIZED=
QUICKPAY_AGREEMENT=
QUICKPAY_BRANDING_ID=

# Optional. Your expose.dev auth token (only used by the Expose client container).
EXPOSE_TOKEN=
