{
    "name": "setono/payum-quickpay",
    "description": "Quickpay gateway for Payum",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "payum",
        "quickpay",
        "payment"
    ],
    "homepage": "https://setono.com",
    "require": {
        "php": ">=8.1",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "payum/core": "^1.6",
        "php-http/message-factory": "^1.0",
        "setono/quickpay-php-sdk": "^1.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.52",
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/psr7": "^2.0",
        "infection/infection": "^0.29.8",
        "php-http/discovery": "^1.19",
        "php-http/guzzle7-adapter": "^1.0",
        "php-http/mock-client": "^1.6",
        "phpspec/prophecy-phpunit": "^2.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5",
        "psr/http-message": "^1.0 || ^2.0",
        "rector/rector": "^2.5",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "sylius-labs/coding-standard": "^4.5"
    },
    "autoload": {
        "psr-4": {
            "Setono\\Payum\\Quickpay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Setono\\Payum\\Quickpay\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "php-http/discovery": false,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "all": [
            "@checks",
            "@test"
        ],
        "analyse": "phpstan analyse",
        "check-style": "ecs check",
        "checks": [
            "@check-style",
            "@analyse"
        ],
        "e2e:create": "php examples/e2e/create-payment.php",
        "e2e:listen": "php -S 0.0.0.0:8000 examples/e2e/listen.php",
        "e2e:operate": "php examples/e2e/operate.php",
        "e2e:smoke": "php examples/e2e/smoke.php",
        "fix-style": "ecs check --fix",
        "infection": "infection --threads=max",
        "phpunit": "phpunit",
        "rector": "rector",
        "test": [
            "@phpunit"
        ]
    }
}
